---
import Mark from "../assets/brand/seestemic-mark-small.svg";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <Mark class="logo-mark" aria-hidden="true" focusable="false" />
  <span class="logo-word">seestemic</span>
</span>
