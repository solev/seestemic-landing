---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  sizes: string;
  class?: string;
  eager?: boolean;
  widths?: number[];
}

const { src, sizes, class: className, eager = false, widths = [640, 960, 1280, 1600, 2000, 2400] } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---

<Image
  src={src}
  alt=""
  widths={usable}
  sizes={sizes}
  class:list={["art", className]}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
  format="webp"
  quality={68}
/>
