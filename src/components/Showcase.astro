---
import Art from "./Art.astro";
import Helper from "./Helper.astro";
import Icon from "./Icon.astro";
import coast from "../assets/art/coast.webp";
import meadow from "../assets/art/meadow.webp";
import { helpers, type IconName } from "../data/helpers";

const tools: { icon: IconName; label: string; color: string; x: number; y: number }[] = [
  { icon: "mail", label: "Email", color: "#2E9EFF", x: 14, y: 20 },
  { icon: "calendar", label: "Calendar", color: "#F07C3A", x: 50, y: 9 },
  { icon: "sheet", label: "Spreadsheets", color: "#3E9E62", x: 86, y: 20 },
  { icon: "book", label: "Accounting", color: "#2FB39A", x: 14, y: 80 },
  { icon: "chat", label: "Website chat", color: "#7A5CFA", x: 50, y: 91 },
  { icon: "folder", label: "Shared files", color: "#D99A1E", x: 86, y: 80 },
];

const sizes = "(min-width: 1280px) 530px, (min-width: 900px) 42vw, 100vw";
---

<div class="showcase">
  <article class="vig">
    <div class="vig-copy">
      <h3>Works inside your tools</h3>
      <p>Email, calendar, spreadsheets, accounting. Your helpers use what you already have, so there’s nothing new to learn.</p>
    </div>
    <div class="vig-art">
      <Art src={coast} sizes={sizes} />
      <div class="v-tools" aria-hidden="true">
        <svg class="v-tools-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          {tools.map((tool) => <line x1="50" y1="50" x2={tool.x} y2={tool.y} vector-effect="non-scaling-stroke" />)}
        </svg>
        {
          tools.map((tool) => (
            <span class="v-tile" style={`--x:${tool.x}%;--y:${tool.y}%;--c:${tool.color}`}>
              <span class="v-tile-icon">
                <Icon name={tool.icon} size={22} />
              </span>
              <span class="v-tile-label">{tool.label}</span>
            </span>
          ))
        }
        <Helper follow class="v-tools-helper" reach={6} />
      </div>
    </div>
  </article>

  <article class="vig">
    <div class="vig-copy">
      <h3>Asks before it acts</h3>
      <p>You decide what a helper may do on its own and what needs your OK. Anything important waits for you.</p>
    </div>
    <div class="vig-art">
      <Art src={meadow} sizes={sizes} />
      <span class="example-tag" aria-hidden="true">Example</span>
      <div class="v-panel v-approve" aria-hidden="true">
        <header class="v-approve-head">
          <Helper variant="avatar" color={helpers.quotes.color} class="v-avatar" />
          <span><b>Quotes</b> wants to send a quote</span>
          <span class="tnum">9:41</span>
        </header>
        <div class="v-approve-body">
          <span>Q-1042 · Dental clinic</span>
          <b class="tnum">€4,860</b>
        </div>
        <div class="v-approve-actions">
          <span class="pill pill-dark">Approve</span>
          <span class="pill pill-light">Edit</span>
          <span class="pill pill-ghost">Not now</span>
        </div>
        <p class="v-approve-rule">
          <Icon name="lock" size={14} />
          Quotes over €1,000 always need your OK
        </p>
      </div>
    </div>
  </article>

  <article class="vig vig--quiet">
    <div class="vig-copy">
      <h3>Remembers how you like it</h3>
      <p>Correct it once and it sticks. Your prices, your tone, your rules.</p>
    </div>
    <div class="vig-stage">
      <span class="example-tag" aria-hidden="true">Example</span>
      <div class="v-flat v-memory" aria-hidden="true">
        <header class="v-memory-head">
          <Icon name="bookmark" size={15} />
          What Quotes remembers
        </header>
        <ul>
          <li class="is-new">
            <span>Always offer Thursday site visits</span>
            <small>From you · today</small>
            <em>New</em>
          </li>
          <li>
            <span>Use the spring price list</span>
            <small>From you · Mar 2</small>
          </li>
          <li>
            <span>Sign off with “Kind regards” and your name</span>
            <small>From you · Feb 18</small>
          </li>
        </ul>
      </div>
    </div>
  </article>

  <article class="vig vig--quiet">
    <div class="vig-copy">
      <h3>Hands work to the next helper</h3>
      <p>A booking becomes a quote, and a quote becomes an invoice. You can see every step along the way.</p>
    </div>
    <div class="vig-stage">
      <span class="example-tag" aria-hidden="true">Example</span>
      <ol class="v-flat v-handoff" aria-hidden="true">
        <li>
          <Helper variant="avatar" color={helpers.frontDesk.color} class="v-avatar" />
          <span><b>Front desk</b> booked a site visit with a new customer</span>
          <small class="tnum">Mon</small>
        </li>
        <li>
          <Helper variant="avatar" color={helpers.quotes.color} class="v-avatar" />
          <span><b>Quotes</b> sent them the quote</span>
          <small class="tnum">Thu</small>
        </li>
        <li class="is-next">
          <Helper variant="avatar" color={helpers.invoices.color} class="v-avatar" />
          <span><b>Invoices</b> will bill when the job is done</span>
          <small>Next</small>
        </li>
      </ol>
    </div>
  </article>
</div>
