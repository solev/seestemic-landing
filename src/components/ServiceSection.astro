---
// Straight after the hero: what we do and what you do.
import Icon from "./Icon.astro";
import Mark from "../assets/brand/seestemic-mark-small.svg";
---

<section class="section" aria-labelledby="service-title">
  <div class="shell">
    <header class="section-head section-head--center">
      <h2 class="h2" id="service-title">We do the work. You stay the boss</h2>
      <p class="lead">
        Seestemic is a service, not software you have to figure out. Setting up AI is our job. Deciding what happens in
        your business stays yours.
      </p>
    </header>
    <div class="split">
      <article class="split-card split-card--us">
        <header class="split-head">
          <span class="split-badge split-badge--us"><Mark aria-hidden="true" focusable="false" /></span>
          <h3>What we do</h3>
        </header>
        <ul class="split-list">
          <li><Icon name="check" size={16} /><span>Find the job worth handing over first, on a free call</span></li>
          <li>
            <Icon name="check" size={16} /><span>Set up your AI teammate and connect it to the tools you already use</span>
          </li>
          <li><Icon name="check" size={16} /><span>Teach it your prices, your tone and your rules</span></li>
          <li><Icon name="check" size={16} /><span>Train the people who’ll work with it, at no extra cost</span></li>
          <li>
            <Icon name="check" size={16} />
            <span>Look after it with Care, if you want us to, and add the next one once it works</span>
          </li>
        </ul>
      </article>
      <article class="split-card">
        <header class="split-head">
          <span class="split-badge"><Icon name="user" size={18} /></span>
          <h3>What you do</h3>
        </header>
        <ol class="split-list split-list--you">
          <li><span class="split-num" aria-hidden="true">1</span><span>Show us how the job is done today</span></li>
          <li><span class="split-num" aria-hidden="true">2</span><span>Decide what it may do on its own</span></li>
          <li><span class="split-num" aria-hidden="true">3</span><span>Say yes before anything important goes out</span></li>
        </ol>
        <p class="split-foot">Then you just message it from your phone or computer.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  .split-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: var(--r-xl);
    background: var(--card);
  }

  .split-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .split-head h3 {
    font-size: clamp(1.3125rem, 1.2rem + 0.35vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .split-badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: #fff;
    color: var(--ink-2);
  }

  .split-badge--us {
    background: var(--ink);
    color: #fff;
  }

  .split-badge--us :global(svg) {
    width: 24px;
    height: 24px;
  }

  .split-list {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
  }

  .split-list li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 0.625rem;
    align-items: baseline;
  }

  .split-list :global(svg) {
    align-self: center;
    justify-self: center;
    color: var(--ok);
  }

  .split-num {
    display: grid;
    place-items: center;
    align-self: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .split-foot {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      max-width: 560px;
      margin-inline: auto;
    }
  }

  @media (max-width: 760px) {
    .split-card {
      padding: 1.5rem;
      border-radius: var(--r-lg);
    }
  }
</style>
