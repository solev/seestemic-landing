---
// PROTOTYPE B "On a painting": centered heading, then a painting stage with a floating profile card and the helper vouching for Martin.
import { Image } from "astro:assets";
import Art from "../Art.astro";
import Helper from "../Helper.astro";
import Icon from "../Icon.astro";
import dusk from "./dusk.webp";
import martin from "./martin.jpg";
import { booking, linkedInUrl } from "./facts";
---

<section class="section" aria-labelledby="who-b-title">
  <div class="shell">
    <header class="section-head section-head--center">
      <h2 class="h2" id="who-b-title">Who’s behind Seestemic</h2>
      <p class="lead">
        Seestemic is run by Martin Solev, a software engineer in Tallinn. When you work with us, you work with him.
      </p>
    </header>
  </div>

  <div class="shell shell-wide">
    <div class="pw-stage">
      <Art src={dusk} widths={[960, 1400, 1600]} sizes="(min-width: 1400px) 1320px, 100vw" class="pw-stage-art" />

      <div class="pw-profile-wrap">
        <article class="pw-profile" aria-label="Martin Solev">
          <header class="pw-profile-head">
            <Image src={martin} alt="" widths={[64, 128]} sizes="64px" class="pw-profile-photo" />
            <div>
              <h3>Martin Solev</h3>
              <p>Founder · Tallinn, Estonia</p>
            </div>
          </header>
          <p class="pw-profile-bio">
            I set up every helper myself, and I’m the one you call when something needs changing.
          </p>
          <ul class="pw-profile-facts">
            <li>
              <Icon name="clock" size={17} />
              12+ years building software
            </li>
            <li>
              <Icon name="users" size={17} />
              Built cloud services used by millions
            </li>
            <li>
              <Icon name="chat" size={17} />
              You talk to me, not a support desk
            </li>
          </ul>
          <div class="pw-profile-actions">
            <a class="btn btn-primary btn-sm" {...booking}>Book a call</a>
            <a class="btn btn-secondary btn-sm" href={linkedInUrl} target="_blank" rel="noreferrer">
              LinkedIn
              <Icon name="external" size={14} />
            </a>
          </div>
        </article>

        <div class="pw-vouch" aria-hidden="true">
          <span class="pw-vouch-say">Martin set me up.</span>
          <Helper follow reach={6} tilt={-8} class="pw-vouch-helper" />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .pw-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(560px, 48vw, 660px);
    padding: clamp(1rem, 5vw, 4rem);
    overflow: hidden;
    border-radius: var(--r-xl);
    background: #cbbfae;
  }

  .pw-stage-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pw-profile-wrap {
    position: relative;
    width: min(100%, 430px);
  }

  .pw-profile {
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.05),
      var(--float);
  }

  .pw-profile-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .pw-profile-photo {
    flex: none;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--card-strong);
  }

  .pw-profile-head h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .pw-profile-head p {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .pw-profile-bio {
    margin-top: 1.125rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .pw-profile-facts {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .pw-profile-facts li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .pw-profile-facts .icon {
    flex: none;
    color: var(--ink);
  }

  .pw-profile-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .pw-vouch {
    position: absolute;
    bottom: -0.5rem;
    left: calc(100% + 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    width: 170px;
  }

  .pw-vouch-say {
    padding: 0.5rem 1rem;
    border-radius: 20px 20px 20px 6px;
    background: #fff;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: var(--lift);
  }

  .pw-vouch-helper {
    width: 132px;
    height: 132px;
    margin-left: 0.5rem;
    filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.25));
  }

  @media (max-width: 1024px) {
    .pw-stage {
      padding-top: 8.5rem;
    }

    .pw-vouch {
      top: -7.25rem;
      bottom: auto;
      left: auto;
      right: 0;
      flex-direction: row-reverse;
      align-items: center;
      gap: 0.5rem;
      width: auto;
    }

    .pw-vouch-say {
      border-radius: 20px 20px 6px;
    }

    .pw-vouch-helper {
      width: 96px;
      height: 96px;
      margin: 0;
    }
  }

  @media (max-width: 480px) {
    .pw-stage {
      min-height: 0;
      padding: 7.5rem 0.75rem 0.75rem;
    }

    .pw-profile {
      padding: 1.25rem;
    }

    .pw-profile-actions .btn {
      flex: 1;
    }

    .pw-vouch {
      top: -6.75rem;
    }

    .pw-vouch-helper {
      width: 84px;
      height: 84px;
    }
  }
</style>
