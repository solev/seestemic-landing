---
// PROTOTYPE C "Chat": Martin introduces himself as a short conversation, ending in quick-reply buttons.
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import martin from "./martin.jpg";
import { booking, linkedInUrl } from "./facts";
---

<section class="section" aria-labelledby="who-c-title">
  <div class="shell">
    <header class="section-head section-head--center">
      <h2 class="h2" id="who-c-title">Who’s behind Seestemic</h2>
      <p class="lead">Short answer: me. Here’s the longer one.</p>
    </header>

    <div class="pw-chat">
      <div class="pw-thread" data-pw-thread>
        <div class="pw-from">
          <Image src={martin} alt="" widths={[48, 96]} sizes="48px" class="pw-from-photo" style="--i:0" />
          <div class="pw-from-msgs">
            <span class="pw-from-name" style="--i:0"><b>Martin Solev</b> Founder, Seestemic</span>
            <p class="pw-msg" style="--i:0">Hi, I’m Martin. I run Seestemic from Tallinn.</p>
            <p class="pw-msg" style="--i:1">
              I’ve built software for over 12 years, including cloud services used by millions of people.
            </p>
          </div>
        </div>

        <div class="pw-you">
          <p class="pw-msg pw-msg--you" style="--i:2">Who would I actually be working with?</p>
        </div>

        <div class="pw-from">
          <Image src={martin} alt="" widths={[48, 96]} sizes="48px" class="pw-from-photo" style="--i:3" />
          <div class="pw-from-msgs">
            <p class="pw-msg" style="--i:3">
              Me. I’m on your first call, I build your helper, and I’m the one you message when something needs
              changing.
            </p>
            <div class="pw-replies" style="--i:4">
              <a class="btn btn-primary" {...booking}>Book a call with Martin</a>
              <a class="btn btn-secondary" href={linkedInUrl} target="_blank" rel="noreferrer">
                LinkedIn
                <Icon name="external" size={15} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const thread = document.querySelector("[data-pw-thread]");
    if (!thread || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    thread.setAttribute("data-anim", "");
    const watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        thread.classList.add("is-in");
        watcher.disconnect();
      },
      { threshold: 0.35 },
    );
    watcher.observe(thread);
  })();
</script>

<style is:global>
  .pw-chat {
    padding: clamp(2rem, 6vw, 4.5rem) clamp(1rem, 5vw, 4rem);
    border-radius: var(--r-xl);
    background: var(--card);
  }

  .pw-thread {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .pw-from {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
    gap: 0.875rem;
  }

  .pw-from-photo {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--card-strong);
  }

  .pw-from-msgs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .pw-from-name {
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .pw-from-name b {
    margin-right: 0.25rem;
    color: var(--ink);
  }

  .pw-msg {
    max-width: 30em;
    padding: 0.75rem 1.125rem;
    border-radius: 22px;
    background: #fff;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.45;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
  }

  .pw-from-msgs .pw-msg:first-of-type {
    border-top-left-radius: 6px;
  }

  .pw-you {
    display: flex;
    justify-content: flex-end;
  }

  .pw-msg--you {
    max-width: 24em;
    border-radius: 22px 22px 6px;
    background: var(--ink);
    color: #fff;
  }

  .pw-replies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.625rem;
  }

  .pw-replies .btn-secondary {
    background: #fff;
  }

  .pw-replies .btn-secondary:hover {
    background: var(--card-strong);
  }

  .pw-thread[data-anim] :is(.pw-from-photo, .pw-from-name, .pw-msg, .pw-replies) {
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 0.5s var(--ease),
      translate 0.6s var(--ease);
    transition-delay: calc(var(--i, 0) * 650ms + 120ms);
  }

  .pw-thread[data-anim].is-in :is(.pw-from-photo, .pw-from-name, .pw-msg, .pw-replies) {
    opacity: 1;
    translate: 0 0;
  }

  @media (max-width: 480px) {
    .pw-from {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 0.625rem;
    }

    .pw-from-photo {
      width: 36px;
      height: 36px;
    }

    .pw-replies .btn {
      flex: 1 1 100%;
    }
  }
</style>
