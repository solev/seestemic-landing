---
import Art from "./Art.astro";
import Helper from "./Helper.astro";
import Icon from "./Icon.astro";
import harvest from "../assets/art/harvest.webp";
import { helpers } from "../data/helpers";
import { care, eur, founding, partner, pilot, pilotOpen, placesLeft, review, setup } from "../data/offer";
import { introCallUrl } from "../data/site";

const booking = {
  href: introCallUrl,
  target: "_blank",
  rel: "noreferrer",
  "data-booking-trigger": "",
  "aria-expanded": "false",
  "aria-controls": "intro-call-calendar",
};
---

<ol class="process">
  <li class="process-card">
    <span class="process-num" aria-hidden="true">1</span>
    <h3>Tell us what eats your week</h3>
    <p>A relaxed call about the jobs that take too long. We’ll be honest about where AI helps, and where it doesn’t.</p>
    <p class="process-price">
      <b>Free</b>
      <span>{review.minutes}-minute AI review</span>
    </p>
    <div class="process-mini mini-list" aria-hidden="true">
      <span class="mini-row is-picked">
        <Icon name="check" size={13} />
        Typing up quotes
        <em>Start here</em>
      </span>
      <span class="mini-row">Chasing late invoices</span>
      <span class="mini-row">Answering the same emails</span>
    </div>
  </li>

  <li class="process-card">
    {
      pilotOpen ? (
        <span class="process-head">
          <span class="process-num" aria-hidden="true">2</span>
          <span class="process-flag">First {founding.places} clients</span>
        </span>
      ) : (
        <span class="process-num" aria-hidden="true">2</span>
      )
    }
    <h3>We set up your first helper</h3>
    <p>One job, done well, inside the tools you already use, with your approval rules built in.</p>
    {
      pilotOpen ? (
        <p class="process-price">
          <b>
            {eur(pilot.price)} <small>one-time</small>
            <s>
              <span class="sr-only">normally from </span>{eur(setup.from)}
            </s>
          </b>
          <span>Founding-client pilot: one small helper, set up for one task</span>
        </p>
      ) : (
        <p class="process-price">
          <b>
            <small>from</small> {eur(setup.from)}
          </b>
          <span>One-time setup</span>
        </p>
      )
    }
    <div class="process-mini mini-setup" aria-hidden="true">
      <span class="mini-setup-head">
        <Helper variant="avatar" color={helpers.quotes.color} class="mini-avatar" />
        <b>Quotes</b>
        <small>Ready</small>
      </span>
      <span class="mini-setup-row">
        <Icon name="mail" size={14} />
        Email
        <i class="mini-on"></i>
      </span>
      <span class="mini-setup-row">
        <Icon name="sheet" size={14} />
        Price list
        <i class="mini-on"></i>
      </span>
      <span class="mini-setup-row">
        <Icon name="lock" size={14} />
        Ask me before sending
        <i class="mini-on"></i>
      </span>
    </div>
  </li>

  <li class="process-card">
    <span class="process-num" aria-hidden="true">3</span>
    <h3>We train your team and stay</h3>
    <p>Hands-on training for the people who’ll use it. Then we measure, fix and add what works.</p>
    <p class="process-price">
      <b>
        <small>from</small> {eur(care.from)} <small class="nowrap">a month,</small>{" "}
        <small class="nowrap">after {care.startsAfter}, optional</small>
      </b>
      <span>Care: up to {care.hours} hours of our time and a check-in each month</span>
    </p>
    <div class="process-mini mini-team" aria-hidden="true">
      <span class="mini-faces">
        <i style="--c:#F2D2B6">S</i>
        <i style="--c:#CFE3F7">M</i>
        <i style="--c:#D8EBCF">J</i>
        <i style="--c:#E7DDF8">+4</i>
      </span>
      <span class="mini-event">
        <Icon name="calendar" size={14} />
        Team training
        <span class="tnum">Tue 10:00</span>
      </span>
      <span class="mini-event">
        <Icon name="replay" size={14} />
        Monthly check-in
        <span class="tnum">1st Mon</span>
      </span>
    </div>
  </li>
</ol>

{
  pilotOpen && (
    <aside class="pilot" aria-labelledby="pilot-title">
      <Art src={harvest} sizes="(min-width: 1280px) 1200px, 100vw" widths={[640, 960, 1400]} class="pilot-art" />
      <div class="pilot-figure" aria-hidden="true">
        <Helper follow class="pilot-helper" reach={8} tilt={-8} />
        <p class="say-reply pilot-reply">I could be your first helper.</p>
      </div>
      <div class="pilot-card">
        <h3 id="pilot-title">Be one of our first {founding.places} clients</h3>
        <p>
          Founding-client pilot: we set up one small AI helper for you at a one-time founding price. In return, we ask
          for a short written case study after <span class="nowrap">{pilot.caseStudyAfter}.</span>
        </p>
        <p class="process-price pilot-price">
          <b>
            {eur(pilot.price)} <small>one-time</small>
            <s>
              <span class="sr-only">normally from </span>{eur(setup.from)}
            </s>
          </b>
          <span>One small helper, set up for one task</span>
        </p>
        <div class="pilot-foot">
          <span class="pilot-seats" aria-hidden="true">
            {Array.from({ length: founding.places }, (_, i) => (
              <i class:list={[i < founding.taken && "is-taken"]} />
            ))}
          </span>
          <p class="pilot-claim">
            {
              founding.taken === 0
                ? `Book a free AI review to claim one of ${founding.places} places.`
                : `Book a free AI review to claim one of the ${placesLeft} places left.`
            }
          </p>
          <a class="btn btn-primary" {...booking}>
            Book a free AI review
          </a>
        </div>
      </div>
    </aside>
  )
}

<div class="partner">
  <div class="partner-intro">
    <h3>Want AI across your whole company?</h3>
    <p>As your Partner, we help every team adopt AI in the ways that fit, not only through helpers.</p>
  </div>
  <ul class="partner-list">
    <li><Icon name="check" size={16} />A plan for where AI can help, team by team</li>
    <li><Icon name="check" size={16} />Help picking AI tools, plus simple rules for using them safely</li>
    <li><Icon name="check" size={16} />Hands-on training for every team</li>
  </ul>
  <p class="process-price">
    <b><small>from</small> {eur(partner.from)} <small>a month</small></b>
    <span>Partner</span>
  </p>
</div>
