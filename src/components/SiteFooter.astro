---
import Logo from "./Logo.astro";
import { email, guidePages, introCallUrl, navLinks } from "../data/site";

interface Props {
  /** Prefix for the homepage's section links, such as "/" on pages other than the homepage. */
  base?: string;
}

const { base = "" } = Astro.props;
const home = base || "#top";
const path = Astro.url.pathname.replace(/\/$/, "");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={home} aria-label="Seestemic home"><Logo /></a>
        <p>AI teammates for the everyday work of running a business.</p>
        <a class="footer-mail" href={`mailto:${email}`}>{email}</a>
      </div>
      <nav class="footer-col" aria-label="Footer">
        <b>Explore</b>
        {navLinks.map((link) => <a href={`${base}${link.href}`}>{link.label}</a>)}
        {
          guidePages.map((page) => (
            <a href={page.href} aria-current={path === page.href ? "page" : undefined}>
              {page.label}
            </a>
          ))
        }
      </nav>
      <div class="footer-col">
        <b>Get in touch</b>
        <a
          href={introCallUrl}
          target="_blank"
          rel="noreferrer"
          data-booking-trigger
          aria-expanded="false"
          aria-controls="intro-call-calendar">Book a free AI review</a
        >
        <a href={`mailto:${email}`}>Email us</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Seestemic</span>
      <span>Start with one job. Keep what works.</span>
    </div>
  </div>
</footer>
