---
import BaseLayout from "../layouts/BaseLayout.astro";
import Art from "../components/Art.astro";
import BookingPanel from "../components/BookingPanel.astro";
import DemoWindow from "../components/DemoWindow.astro";
import Helper from "../components/Helper.astro";
import Icon from "../components/Icon.astro";
import JobPicker from "../components/JobPicker.astro";
import Process from "../components/Process.astro";
import Showcase from "../components/Showcase.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import dawn from "../assets/art/hero-dawn.webp";
import { faqs } from "../data/helpers";
import { email, introCallUrl } from "../data/site";

const booking = {
  href: introCallUrl,
  target: "_blank",
  rel: "noreferrer",
  "data-booking-trigger": "",
  "aria-expanded": "false",
  "aria-controls": "intro-call-calendar",
};
---

<BaseLayout
  title="Seestemic · AI helpers for the busywork in your business"
  description="Seestemic sets up AI helpers that take repetitive jobs off your plate, inside the tools you already use. You stay in charge: nothing important happens without your OK."
>
  <SiteHeader />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="shell">
        <h1 class="hero-title" id="hero-title">
          Let <Helper follow class="h1-helper" reach={8} /> AI handle the busywork
        </h1>
        <p class="hero-sub">
          We set up AI helpers that take repetitive jobs off your plate, inside the tools you already use. You stay in
          charge: nothing important happens without your OK.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" {...booking}>Book an intro call</a>
          <a class="btn btn-secondary" href="#how">How it works</a>
        </div>
        <p class="hero-note">
          <Icon name="check" size={16} />
          No tech skills needed.
        </p>
      </div>

      <figure class="shell shell-wide stage-wrap">
        <div class="stage" id="demo">
          <Art src={dawn} eager widths={[960, 1400, 2000]} sizes="(min-width: 1400px) 1320px, 100vw" class="stage-art" />
          <DemoWindow />
        </div>
        <figcaption class="stage-caption">
          An example of a helper at work. Yours are set up around your own jobs and tools.
        </figcaption>
      </figure>
    </section>

    <section class="section section--teammate" aria-labelledby="talk-title">
      <div class="shell">
        <div class="teammate">
          <div class="teammate-copy">
            <h2 class="h2" id="talk-title">Just tell it what you need</h2>
            <p class="lead">
              No settings, no code. Ask in plain words, the way you’d ask a colleague, and it remembers how you like
              things done.
            </p>
            <ul class="teammate-chat" aria-label="Things you could ask a helper">
              <li class="say">Chase the Corner Bakery invoice.</li>
              <li class="say">Reply to new reviews in my tone.</li>
              <li class="say">Always offer Thursday visits.</li>
            </ul>
          </div>
          <div class="teammate-figure">
            <Helper follow class="teammate-helper" reach={8} tilt={-9} />
            <p class="say-reply">On it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="fits-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="h2" id="fits-title">It fits the way you already work</h2>
          <p class="lead">
            No new system to learn. Your helpers work in your email, calendar and files, and check with you whenever
            it matters.
          </p>
        </header>
        <Showcase />
      </div>
    </section>

    <section class="section" id="examples" aria-labelledby="examples-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="examples-title">Give each helper one job</h2>
          <p class="lead">Start with the job that wastes the most time. Add the next one when it’s working.</p>
        </header>
        <JobPicker />
        <p class="jobs-more">
          Have a different job in mind? <a href={`mailto:${email}`}>Tell us about it</a>
        </p>
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="how-title">Working with us is simple</h2>
          <p class="lead">We start small, prove it works, then grow it with you.</p>
        </header>
        <Process />
        <div class="section-cta">
          <a class="btn btn-primary" {...booking}>Book an intro call</a>
        </div>
      </div>
    </section>

    <section class="section" id="questions" aria-labelledby="questions-title">
      <div class="shell faq">
        <div class="faq-intro">
          <h2 class="h2" id="questions-title">Questions, answered</h2>
          <p class="lead">
            Something we didn’t cover? Email <a href={`mailto:${email}`}>{email}</a> and we’ll answer in plain English.
          </p>
        </div>
        <div class="faq-list">
          {
            faqs.map(([question, answer]) => (
              <details class="faq-item" name="faq">
                <summary>
                  {question}
                  <span class="faq-icon" aria-hidden="true">
                    <Icon name="plus" size={16} />
                  </span>
                </summary>
                <p>{answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing" id="book" aria-labelledby="book-title">
      <div class="shell">
        <h2 class="h2 closing-title" id="book-title">What should AI take off your plate?</h2>
        <p class="closing-sub">
          Bring one repetitive job to an intro call. We’ll tell you honestly whether AI can help, and what a first
          helper could look like.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" {...booking}>Book an intro call</a>
          <a class="btn btn-secondary" href={`mailto:${email}`}>Email us</a>
        </div>
        <BookingPanel />
      </div>
      <div class="closing-figure" data-draw>
        <Helper variant="outline" follow class="closing-helper" reach={6} tilt={-6} />
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initHelpers } from "../scripts/helpers";
    initHelpers();
  </script>

  <script is:inline>
    (() => {
      const triggers = [...document.querySelectorAll("[data-booking-trigger]")];
      const panel = document.querySelector(".cta-booking");
      const closeButton = document.querySelector(".booking-close");
      const status = document.querySelector(".booking-status");
      const statusText = status?.querySelector("span");
      let calendarInitialized = false;
      let lastTrigger = triggers[0];

      if (triggers.length === 0 || !(panel instanceof HTMLElement) || !(closeButton instanceof HTMLButtonElement)) return;

      const initializeCalendar = () => {
        if (calendarInitialized) return;
        calendarInitialized = true;

        (function (C, A, L) {
          const push = function (api, args) { api.q.push(args); };
          const doc = C.document;
          C.Cal = C.Cal || function () {
            const cal = C.Cal;
            const args = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              doc.head.appendChild(doc.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (args[0] === L) {
              const api = function () { push(api, arguments); };
              const namespace = args[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                push(cal.ns[namespace], args);
                push(cal, ["initNamespace", namespace]);
              } else {
                push(cal, args);
              }
              return;
            }
            push(cal, args);
          };
        })(window, "https://app.cal.com/embed/embed.js", "init");

        Cal("init", "intro-call-with-martin", { origin: "https://app.cal.com" });
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;
        Cal.ns["intro-call-with-martin"]("on", {
          action: "linkReady",
          callback: () => status?.setAttribute("hidden", ""),
        });
        Cal.ns["intro-call-with-martin"]("on", {
          action: "linkFailed",
          callback: () => {
            status?.classList.add("is-error");
            if (statusText) statusText.textContent = "Availability could not load. Use the direct Cal.com link above.";
          },
        });
        Cal.ns["intro-call-with-martin"]("inline", {
          elementOrSelector: "#my-cal-inline-intro-call-with-martin",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: true },
          calLink: "martinsolev/intro-call-with-martin",
        });
        Cal.ns["intro-call-with-martin"]("ui", {
          hideEventTypeDetails: false,
          layout: "month_view",
        });
      };

      const openCalendar = (event) => {
        event.preventDefault();
        const clickedTrigger = event.currentTarget;
        if (!(clickedTrigger instanceof HTMLAnchorElement)) return;
        lastTrigger = clickedTrigger;
        const mobileNav = clickedTrigger.closest("details.mobile-nav");
        if (mobileNav instanceof HTMLDetailsElement) mobileNav.open = false;
        panel.hidden = false;
        triggers.forEach((item) => item.setAttribute("aria-expanded", "true"));
        initializeCalendar();
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        requestAnimationFrame(() => panel.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" }));
      };

      const closeCalendar = () => {
        panel.hidden = true;
        triggers.forEach((item) => item.setAttribute("aria-expanded", "false"));
        if (lastTrigger instanceof HTMLElement) lastTrigger.focus({ preventScroll: true });
      };

      triggers.forEach((item) => item.addEventListener("click", openCalendar));
      closeButton.addEventListener("click", closeCalendar);
    })();
  </script>
</BaseLayout>
