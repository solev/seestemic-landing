---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import WorkflowDemo from "../components/WorkflowDemo.astro";
import OperationsScene from "../components/OperationsScene.astro";
import SystemsScene from "../components/SystemsScene.astro";
import EnablementScene from "../components/EnablementScene.astro";
import CapabilityVisual from "../components/CapabilityVisual.astro";
import OpportunityMap from "../components/OpportunityMap.astro";
import PaybackVisual from "../components/PaybackVisual.astro";
import { siGithubcopilot, siGooglegemini } from "simple-icons";

const process = [
  ["01", "Discover", "Rank the workflows where AI can improve a measurable business result.", "Prioritized opportunity map + business case"],
  ["02", "Design", "Map the workflow, controls, data, and success measures.", "Workflow blueprint + control plan"],
  ["03", "Build", "Ship a useful first version inside the tools your team already uses.", "Working pilot + team playbook"],
  ["04", "Improve", "Measure use and results, fix weak points, and expand what works.", "Adoption results + improvement plan"],
];

const faqs = [
  ["Do we need technical knowledge?", "No. We translate business needs into a practical plan, handle the technical delivery, and make sure your team understands how to use what we build."],
  ["Can AI work with our current software?", "Usually, yes. We design around your existing tools—such as Microsoft 365, Google Workspace, CRM platforms, support systems, document stores, and custom applications."],
  ["How quickly can we see value?", "A focused first workflow can often be operating within 3–6 weeks. Larger programs are delivered in stages so useful results arrive early."],
  ["How do you protect company data?", "We define who can access each workflow and data source, which actions require human approval, what gets logged, and which AI providers fit your security requirements."],
  ["Will you train our employees?", "Yes. We provide role-specific workshops, playbooks, and hands-on guidance so employees know when to use AI, how to review its work, and when to take control."],
];

const buildCapabilities = [
  {
    eyebrow: "AUTONOMOUS BUSINESS AGENTS",
    title: "Keep routine operations moving",
    description: "Agents monitor incoming work, handle routine decisions, prepare reports, and alert people when judgment or approval is needed.",
    tags: ["Monitor incoming work", "Handle routine decisions", "Prepare reports"],
    visual: "operations",
  },
  {
    eyebrow: "CUSTOMER SUPPORT & SALES",
    title: "Turn inquiries into clear next steps",
    description: "Assistants answer questions, qualify leads, book meetings, draft quotes, and follow up across the channels you already use.",
    tags: ["Lead qualification", "Customer support", "Sales follow-up"],
    visual: "customer",
  },
  {
    eyebrow: "AI WORKFLOW AUTOMATION",
    title: "Move repetitive work between systems",
    description: "Connected workflows read email and documents, update systems, route requests, and bring approvals to the right person.",
    tags: ["Document processing", "CRM updates", "Approvals"],
    visual: "workflow",
  },
  {
    eyebrow: "AI TOOLS, CODING HARNESSES & CUSTOM AGENTS",
    title: "Turn scattered AI tools into one governed system",
    description: "We connect coding harnesses and everyday AI assistants to shared company context, workflows, permissions, and training—so every team works from the same rules.",
    tags: ["Coding harnesses", "Shared context", "Access & adoption"],
    visual: "ecosystem",
  },
];

const agentPlatforms = [
  { name: "Codex", category: "BUILD", kind: "codex" },
  { name: "Claude Code", category: "BUILD", kind: "claude" },
  { name: "GitHub Copilot", category: "BUILD", icon: siGithubcopilot },
  { name: "Cursor", category: "BUILD", kind: "cursor" },
  { name: "ChatGPT", category: "KNOWLEDGE", kind: "chatgpt" },
  { name: "Microsoft 365 Copilot", category: "KNOWLEDGE", kind: "microsoft" },
  { name: "Gemini", category: "KNOWLEDGE", icon: siGooglegemini },
  { name: "Custom agents", category: "YOUR WORKFLOWS", kind: "seestemic" },
];

const testimonials = [
  {
    quote: "Seestemic helped us move from broad AI ideas to a workflow our team could actually use. The value was clear because it was designed around how we already work.",
    name: "Sarah Lin",
    role: "COO, Northline Advisory",
  },
  {
    quote: "They treated adoption as part of delivery. Our team understood what changed, where to stay in control, and how to keep improving the workflow after launch.",
    name: "Daniel Weber",
    role: "Managing Director, Atlas Property Group",
  },
  {
    quote: "The strongest part was the partnership: practical priorities, senior technical judgment, and no pressure to force AI into the wrong places.",
    name: "Maya Chen",
    role: "VP Operations, Fieldstone Commerce",
  },
];

const paybackAreas = [
  {
    number: "01",
    eyebrow: "REPETITIVE COORDINATION",
    title: "Keep requests and handoffs moving.",
    description: "AI can route email, schedule work, update CRMs, follow up, and manage approvals without the constant copy-paste and chasing.",
    examples: ["Email routing", "Scheduling", "CRM updates", "Approvals"],
    industries: "Professional services · Agencies · Real estate · SaaS",
    visual: "coordination",
  },
  {
    number: "02",
    eyebrow: "DOCUMENT-HEAVY OPERATIONS",
    title: "Turn documents into usable work.",
    description: "Extract information, review submissions, process invoices, produce reports, and send the right details to the right system.",
    examples: ["Data extraction", "Document review", "Invoices", "Reports"],
    industries: "Healthcare · Finance · Manufacturing · Logistics",
    visual: "documents",
  },
  {
    number: "03",
    eyebrow: "KNOWLEDGE BOTTLENECKS",
    title: "Make company knowledge easy to use.",
    description: "Give employees fast, permission-aware answers from policies, SOPs, customer history, and operational documentation.",
    examples: ["Internal search", "SOP guidance", "Employee support", "Handovers"],
    industries: "Useful across every growing organization",
    visual: "knowledge",
  },
];

const introCallLink = "martinsolev/intro-call-with-martin";
const introCallUrl = `https://cal.com/${introCallLink}`;
---

<BaseLayout
  title="Seestemic — AI strategy, systems, and adoption"
  description="Seestemic helps businesses identify valuable AI opportunities, build agents and workflows around existing tools, and train teams to use them safely."
>
  <main id="top">
    <header class="site-header page-shell">
      <a href="#top" aria-label="Seestemic home"><Brand /></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#capabilities">Capabilities</a>
        <a href="#approach">Approach</a>
        <a href="#company-details">Company</a>
      </nav>
      <a class="header-cta" href={introCallUrl} target="_blank" rel="noreferrer" data-booking-trigger aria-expanded="false" aria-controls="intro-call-calendar">Start a conversation <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav"><summary aria-label="Open navigation"><i></i><i></i></summary><div><a href="#capabilities">Capabilities</a><a href="#approach">Approach</a><a href="#company-details">Company</a><a href={introCallUrl} target="_blank" rel="noreferrer" data-booking-trigger aria-expanded="false" aria-controls="intro-call-calendar">Start a conversation</a></div></details>
    </header>

    <section class="hero page-shell">
      <div class="hero-kicker"><span>YOUR LONG-TERM AI PARTNER</span><i>Strategy · Systems · Adoption</i></div>
      <h1>Put AI to work across your business.</h1>
      <div class="hero-bottom">
        <p>We help your team choose where AI will create value, build agents and workflows inside your current systems, and train people to use them—with clear controls and measurable outcomes.</p>
        <div class="hero-actions"><a class="primary-button" href={introCallUrl} target="_blank" rel="noreferrer" data-booking-trigger aria-expanded="false" aria-controls="intro-call-calendar">Find your first AI opportunity <span aria-hidden="true">↗</span></a><a class="text-button" href="#workflow-demo">See a workflow in action <span aria-hidden="true">↓</span></a></div>
      </div>
    </section>

    <section class="demo-wrap page-shell" id="workflow-demo">
      <WorkflowDemo />
      <div class="demo-caption"><p><span>01</span> One workflow, from request to result.</p><p>AI handles the coordination. Your team keeps control.</p></div>
    </section>

    <section class="proof-strip page-shell">
      <div><small>EXPERIENCE</small><b>12+ years building enterprise software</b></div>
      <div><small>DELIVERY</small><b>From strategy to working systems</b></div>
      <div><small>INTEGRATION</small><b>Built around the tools you already use</b></div>
      <div><small>CONTROL</small><b>Human oversight where it matters</b></div>
    </section>

    <section class="opportunity-section page-shell" id="opportunity">
      <span class="section-index">01 / FIND THE VALUE</span>
      <div class="opportunity-head"><h2>We don’t start with an AI product.<br />We start with where AI creates the clearest return.</h2><p>Together, we rank what is worth improving now, what should wait, which controls each workflow needs, and what result it must deliver—before we choose the technology.</p></div>
      <div class="opportunity-workspace"><OpportunityMap /><aside class="decision-panel"><span>WHAT WE DECIDE TOGETHER</span><ol><li><i>01</i><p><b>Business outcome</b><small>Which result should improve—and by how much?</small></p></li><li><i>02</i><p><b>Workflow and data</b><small>Where do the work, information, and delays live today?</small></p></li><li><i>03</i><p><b>Controls and ownership</b><small>Which decisions need human review, and who owns them?</small></p></li><li><i>04</i><p><b>Proof of value</b><small>Which signals will show the workflow is working?</small></p></li></ol><div><small>FIRST DELIVERABLE</small><b>A prioritized roadmap with the business case, controls, and next workflow.</b></div></aside></div>
    </section>

    <section class="build-overview page-shell" id="capabilities">
      <span class="section-index">02 / WHAT WE CAN BUILD</span>
      <div class="build-overview-head"><h2>What we can build.</h2><p>Four practical ways to remove repetitive work, improve response times, and give your team more capacity—built around the systems you already use.</p></div>
      <div class="capability-grid">{buildCapabilities.map((capability, index) => <article class="capability-card"><div class="capability-number">0{index + 1}</div><CapabilityVisual type={capability.visual} platforms={agentPlatforms} /><div class="capability-copy"><span>{capability.eyebrow}</span><h3>{capability.title}</h3><p>{capability.description}</p><ul>{capability.tags.map((tag) => <li>{tag}</li>)}</ul></div></article>)}</div>
      <div class="capability-bridge"><span>A CLOSER LOOK</span><p>Explore how three of these systems work in practice.</p><i>↓</i></div>
    </section>

    <section class="story-chapter"><article class="story-block page-shell"><div class="story-copy"><span>01 / AUTONOMOUS OPERATIONS</span><h3>Agents complete routine work.</h3><p>Always-on agents monitor inboxes, orders, and documents; handle routine decisions; and bring exceptions to the right person for review.</p><ul><li>Monitor inboxes, orders, and documents</li><li>Resolve routine exceptions within clear rules</li><li>Prepare reports and trigger the next step</li></ul></div><OperationsScene /></article></section>

    <section class="story-chapter story-chapter-tint"><article class="story-block reverse page-shell"><div class="story-copy"><span>02 / CONNECTED WORKFLOWS</span><h3>Connect one workflow across your systems.</h3><p>AI moves information between email, documents, CRM, calendars, and other tools—reducing copy-paste work and missed handoffs without adding another dashboard to manage.</p><ul><li>Connect email, CRM, documents, and calendars</li><li>Bring approvals to people at the right moment</li><li>Keep a clear audit trail from request to result</li></ul></div><SystemsScene /></article></section>

    <section class="story-chapter"><article class="story-block page-shell"><div class="story-copy"><span>03 / AI ENABLEMENT</span><h3>Give AI tools shared context and guardrails.</h3><p>We define where coding harnesses—Codex, Claude Code, Copilot, and Cursor—and knowledge tools—ChatGPT, Microsoft 365 Copilot, and Gemini—fit. Then we connect them to shared company context, workflows, permissions, and human review.</p><ul><li>Choose the right tool for each role and task</li><li>Give tools shared skills, context, and automations</li><li>Set access rules, train teams, and measure adoption</li></ul></div><EnablementScene platforms={agentPlatforms} /></article></section>

    <section class="partner-section" id="partnership"><div class="page-shell"><span class="section-index">03 / THE PARTNERSHIP</span><div class="partner-head"><h2>One partner.<br />From first opportunity<br />to everyday capability.</h2><p>We stay with the work from prioritization through delivery, training, and improvement—so AI becomes part of how your business operates, not another isolated pilot.</p></div><div class="partner-path"><article><span>01</span><b>Find the value</b><p>Rank opportunities by business impact, effort, and risk.</p></article><article><span>02</span><b>Build it around you</b><p>Connect custom agents and workflows to the tools your team already uses.</p></article><article class="training-card"><span>03</span><small>TRAINING INCLUDED</small><b>Teach the team</b><p>Hands-on training, role-based playbooks, and clear review responsibilities.</p></article><article><span>04</span><b>Improve what works</b><p>Measure use and results, fix weak points, and expand proven workflows.</p></article></div><div class="partner-note"><span>ENABLEMENT, NOT A HANDOVER</span><h3>Your team should understand and own the system—not depend on us to run it.</h3><p>We teach employees when to use AI, how to review its work, and when to take control. We also equip internal owners to update playbooks, track adoption, and spot the next useful workflow.</p></div></div></section>

    <section class="approach page-shell" id="approach"><span class="section-index">04 / HOW WE WORK</span><div class="approach-head"><h2>Start focused.<br />Prove value.<br />Expand with confidence.</h2><p>A practical four-stage process that puts one useful workflow into employees’ hands, proves its value, and then expands what works.</p></div><div class="process-grid">{process.map(([number, title, description, output], index) => <article><div><span>{number}</span>{index < 3 && <i></i>}</div><h3>{title}</h3><p>{description}</p><div class="process-output"><small>YOU RECEIVE</small><b>{output}</b></div></article>)}</div></section>

    <section class="credibility" id="company-details"><div class="page-shell credibility-inner"><span class="section-index light">05 / WHY SEESTEMIC</span><div class="credibility-main"><h2>Senior engineering.<br />Business-first delivery.<br /><span>Built for the long term.</span></h2><p>We combine product judgment, enterprise engineering, and hands-on enablement—connecting the business case, the working system, and the people responsible for it.</p></div><div class="credibility-facts"><div><b>12+</b><span>years building enterprise software</span></div><div><b>01</b><span>accountable partner from strategy through adoption</span></div><div><b>∞</b><span>continuous improvement after launch</span></div></div></div></section>

    <section class="testimonials page-shell"><span class="section-index">06 / CLIENT PERSPECTIVE</span><div class="testimonials-head"><h2>Built for outcomes,<br />not optics.</h2><p>Representative client stories for this prototype. Replace them with verified testimonials before publication.</p></div><div class="testimonial-grid">{testimonials.map((testimonial, index) => <article class={index === 0 ? "featured" : ""}><span class="sample-label">PLACEHOLDER TESTIMONIAL</span><blockquote>“{testimonial.quote}”</blockquote><footer><div class="testimonial-avatar">{testimonial.name.split(" ").map((part) => part[0]).join("")}</div><p><b>{testimonial.name}</b><small>{testimonial.role}</small></p></footer></article>)}</div></section>

    <section class="payback-section page-shell" id="where-ai-pays-back"><span class="section-index">07 / WHERE AI PAYS BACK</span><div class="payback-head"><h2>Where AI usually<br />pays back first.</h2><p>The strongest opportunities often share the same underlying pattern: frequent work, clear rules, and valuable employee attention being consumed by coordination or searching.</p></div><div class="payback-grid">{paybackAreas.map((area) => <article><div class="payback-number">{area.number}</div><PaybackVisual type={area.visual} /><div class="payback-copy"><span>{area.eyebrow}</span><h3>{area.title}</h3><p>{area.description}</p><ul aria-label="Typical applications">{area.examples.map((example) => <li>{example}</li>)}</ul><footer><small>Often relevant to</small><b>{area.industries}</b></footer></div></article>)}</div><div class="payback-note"><span>SAME PATTERNS. DIFFERENT REALITIES.</span><p>We learn your industry through its workflows, constraints, data, and people—then tailor the solution around how your business actually operates.</p></div></section>

    <section class="faq page-shell"><div class="faq-title"><span class="section-index">08 / FAQ</span><h2>Clear answers.<br />No AI theatre.</h2><a href="mailto:hello@seestemic.com">Ask us directly <span aria-hidden="true">↗</span></a></div><div class="faq-list">{faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<i aria-hidden="true">+</i></summary><p>{answer}</p></details>)}</div></section>

    <section class="final-cta page-shell" id="book-an-intro-call">
      <div class="cta-copy">
        <span>YOUR FIRST USEFUL AI WORKFLOW</span>
        <h2>What should AI<br />take off your plate?</h2>
        <p>Bring us one repetitive process, slow handoff, or overloaded team. We’ll identify where AI could help, what needs human judgment, and the most useful first step.</p>
        <div class="cta-action">
          <a
            class="booking-trigger"
            href={introCallUrl}
            target="_blank"
            rel="noreferrer"
            data-booking-trigger
            aria-expanded="false"
            aria-controls="intro-call-calendar"
          >
            Book an intro call
            <svg aria-hidden="true" viewBox="0 0 16 16">
              <path d="M8 3.25v9.5m-3.75-3.5L8 12.75l3.75-3.5" />
            </svg>
          </a>
          <small>The calendar opens below, without leaving the page.</small>
        </div>
      </div>

      <aside class="cta-artifact" aria-label="Illustrative example of a first AI opportunity brief">
        <article class="opportunity-brief">
          <header class="brief-header">
            <div>
              <span>SEESTEMIC / OPPORTUNITY BRIEF</span>
              <b>First AI opportunity</b>
            </div>
            <small>ILLUSTRATIVE EXAMPLE</small>
          </header>

          <div class="brief-lead">
            <small>CURRENT PROCESS</small>
            <h3>Quote requests are copied from email into CRM by hand.</h3>
          </div>

          <div class="brief-fields">
            <section class="brief-field brief-outcome">
              <small>DESIRED OUTCOME</small>
              <b>A complete draft ready sooner</b>
            </section>
            <section class="brief-field brief-systems">
              <small>SYSTEMS INVOLVED</small>
              <div><span>Email</span><span>CRM</span><span>Quote templates</span></div>
            </section>
            <section class="brief-field brief-review">
              <small>HUMAN DECISION</small>
              <p><i aria-hidden="true"></i><b>Account owner approves price and terms</b></p>
            </section>
          </div>

          <footer class="brief-recommendation">
            <div>
              <small>RECOMMENDED FIRST STEP</small>
              <b>Map intake, drafting, and approval</b>
            </div>
            <span>01 / DISCOVERY</span>
          </footer>
        </article>
        <p class="brief-caption"><span>WHAT YOU LEAVE WITH</span><b>A clear first move—not another AI wish list.</b></p>
      </aside>

      <section class="cta-booking" id="intro-call-calendar" aria-labelledby="intro-call-title" hidden>
        <header class="booking-header">
          <div>
            <h3 id="intro-call-title">Choose a time with Martin.</h3>
            <p>Pick a slot that works for you. Cal.com will show availability in your local timezone.</p>
          </div>
          <div class="booking-header-actions">
            <a href={introCallUrl} target="_blank" rel="noreferrer">
              Open Cal.com
              <svg aria-hidden="true" viewBox="0 0 16 16">
                <path d="M5 11 11.5 4.5M6.5 4.5h5v5" />
              </svg>
            </a>
            <button class="booking-close" type="button" aria-label="Close booking calendar">
              <span>Close calendar</span>
              <svg aria-hidden="true" viewBox="0 0 16 16">
                <path d="m4 4 8 8m0-8-8 8" />
              </svg>
            </button>
          </div>
        </header>

        <div class="booking-frame">
          <div class="booking-status" role="status" aria-live="polite">
            <i aria-hidden="true"></i>
            <span>Loading current availability…</span>
          </div>
          <div class="cal-inline" id="my-cal-inline-intro-call-with-martin"></div>
          <noscript>
            <p>JavaScript is required for the embedded calendar. <a href={introCallUrl}>Open Martin’s Cal.com page</a>.</p>
          </noscript>
        </div>
      </section>
    </section>

    <footer class="site-footer page-shell"><div class="footer-main"><div><Brand /><p>AI strategy, custom agents, connected workflows, and team enablement for businesses ready to work smarter.</p><a href="mailto:hello@seestemic.com">hello@seestemic.com <span aria-hidden="true">↗</span></a></div><div><b>Explore</b><a href="#capabilities">Capabilities</a><a href="#approach">Approach</a><a href="#company-details">Company</a></div><div><b>Connect</b><a href="mailto:hello@seestemic.com">Contact</a><a href="#linkedin">LinkedIn</a></div><div><b>Legal</b><a href="#privacy">Privacy</a></div></div><div class="footer-bottom"><span>© 2026 Seestemic</span><span>AI that works for business.</span></div></footer>
  </main>

  <script is:inline>
    (() => {
      const triggers = [...document.querySelectorAll("[data-booking-trigger]")];
      const panel = document.querySelector(".cta-booking");
      const closeButton = document.querySelector(".booking-close");
      const status = document.querySelector(".booking-status");
      const statusText = status?.querySelector("span");
      let calendarInitialized = false;
      let lastTrigger = triggers[0];

      if (triggers.length === 0 || !(panel instanceof HTMLElement) || !(closeButton instanceof HTMLButtonElement)) return;

      const initializeCalendar = () => {
        if (calendarInitialized) return;
        calendarInitialized = true;

        (function (C, A, L) {
          const push = function (api, args) { api.q.push(args); };
          const doc = C.document;
          C.Cal = C.Cal || function () {
            const cal = C.Cal;
            const args = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              doc.head.appendChild(doc.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (args[0] === L) {
              const api = function () { push(api, arguments); };
              const namespace = args[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                push(cal.ns[namespace], args);
                push(cal, ["initNamespace", namespace]);
              } else {
                push(cal, args);
              }
              return;
            }
            push(cal, args);
          };
        })(window, "https://app.cal.com/embed/embed.js", "init");

        Cal("init", "intro-call-with-martin", { origin: "https://app.cal.com" });
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;
        Cal.ns["intro-call-with-martin"]("on", {
          action: "linkReady",
          callback: () => status?.setAttribute("hidden", ""),
        });
        Cal.ns["intro-call-with-martin"]("on", {
          action: "linkFailed",
          callback: () => {
            status?.classList.add("is-error");
            if (statusText) statusText.textContent = "Availability could not load. Use the direct Cal.com link above.";
          },
        });
        Cal.ns["intro-call-with-martin"]("inline", {
          elementOrSelector: "#my-cal-inline-intro-call-with-martin",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: true },
          calLink: "martinsolev/intro-call-with-martin",
        });
        Cal.ns["intro-call-with-martin"]("ui", {
          hideEventTypeDetails: false,
          layout: "month_view",
        });
      };

      const openCalendar = (event) => {
        event.preventDefault();
        const clickedTrigger = event.currentTarget;
        if (!(clickedTrigger instanceof HTMLAnchorElement)) return;
        lastTrigger = clickedTrigger;
        const mobileNav = clickedTrigger.closest("details.mobile-nav");
        if (mobileNav instanceof HTMLDetailsElement) mobileNav.open = false;
        panel.hidden = false;
        triggers.forEach((item) => item.setAttribute("aria-expanded", "true"));
        initializeCalendar();
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        requestAnimationFrame(() => panel.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" }));
      };

      const closeCalendar = () => {
        panel.hidden = true;
        triggers.forEach((item) => item.setAttribute("aria-expanded", "false"));
        if (lastTrigger instanceof HTMLElement) lastTrigger.focus({ preventScroll: true });
      };

      triggers.forEach((item) => item.addEventListener("click", openCalendar));
      closeButton.addEventListener("click", closeCalendar);
    })();
  </script>
</BaseLayout>
