---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Art from "../components/Art.astro";
import BookingPanel from "../components/BookingPanel.astro";
import BookingScript from "../components/BookingScript.astro";
import DemoWindow from "../components/DemoWindow.astro";
import ExampleJobs from "../components/ExampleJobs.astro";
import FounderChat from "../components/FounderChat.astro";
import Helper from "../components/Helper.astro";
import Icon from "../components/Icon.astro";
import Process from "../components/Process.astro";
import ServiceSection from "../components/ServiceSection.astro";
import Showcase from "../components/Showcase.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import dawn from "../assets/art/hero-dawn.webp";
import martin from "../assets/martin.jpg";
import { faqs } from "../data/helpers";
import { review } from "../data/offer";
import { homeSchema, toJsonLd } from "../data/schema";
import { email, estoniaPage, introCallUrl } from "../data/site";

const booking = {
  href: introCallUrl,
  target: "_blank",
  rel: "noreferrer",
  "data-booking-trigger": "",
  "aria-expanded": "false",
  "aria-controls": "intro-call-calendar",
};
---

<BaseLayout
  title="AI Teammates for Small Businesses | Seestemic"
  description={`We set up AI teammates for whatever eats your week, connected to the tools you already use. You approve first. Book a free ${review.minutes}-min AI review.`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={toJsonLd(homeSchema)} />
  <SiteHeader />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="shell">
        <h1 class="hero-title" id="hero-title">
          Let <Helper follow class="h1-helper" reach={8} /> AI teammates handle the busywork
        </h1>
        <p class="hero-sub">
          We set up AI teammates that take repetitive jobs off your plate, connected to the tools you already use, and
          we can look after them for you.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" {...booking}>Book a free AI review</a>
          <a class="btn btn-secondary" href="#how">How it works</a>
        </div>
        <p class="hero-note hero-note--martin">
          <Image src={martin} alt="" widths={[24, 48]} sizes="24px" class="hero-note-photo" />
          Free {review.minutes}-minute call with Martin, our founder. No tech skills needed.
        </p>
      </div>

      <figure class="shell shell-wide stage-wrap">
        <div class="stage" id="demo">
          <Art src={dawn} eager widths={[960, 1400, 2000]} sizes="(min-width: 1400px) 1320px, 100vw" class="stage-art" />
          <DemoWindow />
        </div>
        <figcaption class="stage-caption">
          Example: your AI teammates at work. We set them up around your jobs and tools, and our team can look after
          them.
        </figcaption>
      </figure>
    </section>

    <ServiceSection />
    <ExampleJobs />

    <section class="section section--teammate" aria-labelledby="talk-title">
      <div class="shell">
        <div class="teammate">
          <div class="teammate-copy">
            <h2 class="h2" id="talk-title">Talk to it like a new colleague</h2>
            <p class="lead">No settings, no code. Ask in plain words, and it remembers how you like things done.</p>
            <ul class="teammate-chat" aria-label="Things you could ask an AI teammate">
              <li class="say">Chase the café’s late invoice.</li>
              <li class="say">Reply to new reviews in my tone.</li>
              <li class="say">Always offer Thursday visits.</li>
            </ul>
          </div>
          <div class="teammate-figure">
            <Helper follow class="teammate-helper" reach={8} tilt={-9} />
            <p class="say-reply">On it. I’ll check with you first.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="fits-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="h2" id="fits-title">It becomes part of your team</h2>
          <p class="lead">
            We connect each AI teammate to your email, calendar and files. You and your team message it, and it checks
            with you whenever it matters.
          </p>
        </header>
        <Showcase />
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="how-title">Working with us is simple</h2>
          <p class="lead">We start small, prove it works, then grow it with you. Here’s what each step costs.</p>
        </header>
        <Process />
        <p class="process-note">
          Everything we set up is yours to keep. AI costs, such as an AI subscription, are paid separately.
        </p>
        <p class="process-note">No VAT is added, as Seestemic isn’t <span class="nowrap">VAT-registered</span>.</p>
        <p class="process-note">
          Larger setups of <span class="tnum">€4,000</span> or more may qualify for <a href="#funding">EIS co-funding</a>.
        </p>
        <div class="section-cta">
          <a class="btn btn-primary" {...booking}>Book a free AI review</a>
        </div>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="about-title">The people behind your AI teammates</h2>
          <p class="lead">Short answer: Martin and our team. Here’s the longer one.</p>
        </header>
        <FounderChat />
      </div>
    </section>

    <section class="section" id="questions" aria-labelledby="questions-title">
      <div class="shell faq">
        <div class="faq-intro">
          <h2 class="h2" id="questions-title">Questions, answered</h2>
          <p class="lead">
            Something we didn’t cover? Email <a href={`mailto:${email}`}>{email}</a> and we’ll answer in plain English.
          </p>
          <p class="lead">
            For longer answers on prices, EIS funding and data safety, read our guide to{" "}
            <a href={estoniaPage.href}>{estoniaPage.label}</a>.
          </p>
        </div>
        <div class="faq-list">
          {
            faqs.map(({ id, question, answer, link }) => (
                <details class="faq-item" name="faq" id={id}>
                  <summary>
                    {question}
                    <span class="faq-icon" aria-hidden="true">
                      <Icon name="plus" size={16} />
                    </span>
                  </summary>
                  <p>
                    {answer}
                    {link && (
                      <>
                        {" "}
                        <a href={link.href} target="_blank" rel="noreferrer">
                          {link.label}
                        </a>
                      </>
                    )}
                  </p>
                </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing" id="book" aria-labelledby="book-title">
      <div class="shell">
        <h2 class="h2 closing-title" id="book-title">Your first AI teammate starts with a conversation</h2>
        <p class="closing-sub">
          A free {review.minutes}-minute AI review with Martin. Bring one repetitive job. There’s nothing else to prepare.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" {...booking}>Book a free AI review</a>
          <a class="btn btn-secondary" href={`mailto:${email}`}>Email us</a>
        </div>
        <p class="closing-note">
          <Icon name="lock" size={16} />
          You decide what your AI teammates can see, and we sign a data processing agreement with you.
        </p>
        <BookingPanel />
      </div>
      <div class="closing-figure" data-draw>
        <Helper variant="outline" follow class="closing-helper" reach={6} tilt={-6} />
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initHelpers } from "../scripts/helpers";
    initHelpers();
  </script>

  <script is:inline>
    (() => {
      // A link to a closed FAQ item opens it, so "EIS co-funding" lands on the answer.
      const openTarget = (hash) => {
        const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
        if (target instanceof HTMLDetailsElement) target.open = true;
      };
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", () => openTarget(link.hash));
      });
      openTarget(location.hash);
    })();
  </script>

  <BookingScript />
</BaseLayout>
