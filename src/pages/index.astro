---
import BaseLayout from "../layouts/BaseLayout.astro";
import Art from "../components/Art.astro";
import BookingPanel from "../components/BookingPanel.astro";
import BookingScript from "../components/BookingScript.astro";
import DemoWindow from "../components/DemoWindow.astro";
import FounderChat from "../components/FounderChat.astro";
import Helper from "../components/Helper.astro";
import Icon from "../components/Icon.astro";
import JobPicker from "../components/JobPicker.astro";
import Process from "../components/Process.astro";
import Showcase from "../components/Showcase.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import dawn from "../assets/art/hero-dawn.webp";
import { faqs } from "../data/helpers";
import { review } from "../data/offer";
import { homeSchema, toJsonLd } from "../data/schema";
import { costGuidePage, email, estoniaPage, introCallUrl } from "../data/site";

const booking = {
  href: introCallUrl,
  target: "_blank",
  rel: "noreferrer",
  "data-booking-trigger": "",
  "aria-expanded": "false",
  "aria-controls": "intro-call-calendar",
};
---

<BaseLayout
  title="AI Helpers for Small Businesses in Estonia | Seestemic"
  description={`We set up AI helpers for quotes, email, bookings and invoices inside your own tools. You approve first. EU data. Book a free ${review.minutes}-min AI review.`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={toJsonLd(homeSchema)} />
  <SiteHeader />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="shell">
        <h1 class="hero-title" id="hero-title">
          Let <Helper follow class="h1-helper" reach={8} /> AI handle the busywork
        </h1>
        <p class="hero-sub">
          We set up AI helpers that take repetitive jobs off your plate, inside the tools you already use. You stay in
          charge: nothing important happens without your OK.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" {...booking}>Book a free AI review</a>
          <a class="btn btn-secondary" href="#how">How it works</a>
        </div>
        <p class="hero-note">
          <Icon name="check" size={16} />
          No tech skills needed.
        </p>
      </div>

      <figure class="shell shell-wide stage-wrap">
        <div class="stage" id="demo">
          <Art src={dawn} eager widths={[960, 1400, 2000]} sizes="(min-width: 1400px) 1320px, 100vw" class="stage-art" />
          <DemoWindow />
        </div>
        <figcaption class="stage-caption">
          An example of a helper at work. Yours are set up around your own jobs and tools.
        </figcaption>
      </figure>
    </section>

    <section class="section section--teammate" aria-labelledby="talk-title">
      <div class="shell">
        <div class="teammate">
          <div class="teammate-copy">
            <h2 class="h2" id="talk-title">Just tell it what you need</h2>
            <p class="lead">
              No settings, no code. Ask in plain words, the way you’d ask a colleague, and it remembers how you like
              things done.
            </p>
            <ul class="teammate-chat" aria-label="Things you could ask a helper">
              <li class="say">Chase the café’s late invoice.</li>
              <li class="say">Reply to new reviews in my tone.</li>
              <li class="say">Always offer Thursday visits.</li>
            </ul>
          </div>
          <div class="teammate-figure">
            <Helper follow class="teammate-helper" reach={8} tilt={-9} />
            <p class="say-reply">On it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="fits-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="h2" id="fits-title">It fits the way you already work</h2>
          <p class="lead">
            No new system to learn. Your helpers work in your email, calendar and files, and check with you whenever
            it matters.
          </p>
        </header>
        <Showcase />
      </div>
    </section>

    <section class="section" id="examples" aria-labelledby="examples-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="examples-title">Give each helper one job</h2>
          <p class="lead">Start with the job that wastes the most time. Add the next one when it’s working.</p>
        </header>
        <JobPicker />
        <p class="jobs-more">
          Have a different job in mind? <a href={`mailto:${email}`}>Tell us about it</a>
        </p>
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="how-title">Working with us is simple</h2>
          <p class="lead">We start small, prove it works, then grow it with you. Here’s what each step costs.</p>
        </header>
        <Process />
        <p class="process-note">
          Everything we build is yours to keep. AI costs, such as an AI subscription, are paid separately.
        </p>
        <p class="process-note">No VAT is added, as Seestemic isn’t <span class="nowrap">VAT-registered</span>.</p>
        <p class="process-note">
          Larger setups of <span class="tnum">€4,000</span> or more may qualify for <a href="#funding">EIS co-funding</a>.
        </p>
        <div class="section-cta">
          <a class="btn btn-primary" {...booking}>Book a free AI review</a>
        </div>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="shell">
        <header class="section-head section-head--center">
          <h2 class="h2" id="about-title">Who’s behind Seestemic</h2>
          <p class="lead">Short answer: Martin. Here’s the longer one.</p>
        </header>
        <FounderChat />
      </div>
    </section>

    <section class="section" id="questions" aria-labelledby="questions-title">
      <div class="shell faq">
        <div class="faq-intro">
          <h2 class="h2" id="questions-title">Questions, answered</h2>
          <p class="lead">
            Something we didn’t cover? Email <a href={`mailto:${email}`}>{email}</a> and we’ll answer in plain English.
          </p>
          <p class="lead">
            For longer answers on prices, EIS funding and data safety, read our guides to{" "}
            <a href={estoniaPage.href}>{estoniaPage.label}</a> and{" "}
            <a href={costGuidePage.href}>what AI automation costs</a>.
          </p>
        </div>
        <div class="faq-list">
          {
            faqs.map(({ id, question, answer, link }) => (
              <details class="faq-item" name="faq" id={id}>
                <summary>
                  {question}
                  <span class="faq-icon" aria-hidden="true">
                    <Icon name="plus" size={16} />
                  </span>
                </summary>
                <p>
                  {answer}
                  {link && (
                    <>
                      {" "}
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}
                      </a>
                    </>
                  )}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing" id="book" aria-labelledby="book-title">
      <div class="shell">
        <h2 class="h2 closing-title" id="book-title">What should AI take off your plate?</h2>
        <p class="closing-sub">
          Bring one repetitive job to a free {review.minutes}-minute AI review. We’ll tell you honestly whether AI can help, and what
          a first helper could look like.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" {...booking}>Book a free AI review</a>
          <a class="btn btn-secondary" href={`mailto:${email}`}>Email us</a>
        </div>
        <p class="closing-note">
          <Icon name="lock" size={16} />
          Your data can stay in the EU, and we sign a data processing agreement with you.
        </p>
        <BookingPanel />
      </div>
      <div class="closing-figure" data-draw>
        <Helper variant="outline" follow class="closing-helper" reach={6} tilt={-6} />
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initHelpers } from "../scripts/helpers";
    initHelpers();
  </script>

  <script is:inline>
    (() => {
      // A link to a closed FAQ item opens it, so "EIS co-funding" lands on the answer.
      const openTarget = (hash) => {
        const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
        if (target instanceof HTMLDetailsElement) target.open = true;
      };
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", () => openTarget(link.hash));
      });
      openTarget(location.hash);
    })();
  </script>

  <BookingScript />
</BaseLayout>
