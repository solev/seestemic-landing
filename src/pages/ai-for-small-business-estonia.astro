---
import BaseLayout from "../layouts/BaseLayout.astro";
import Art from "../components/Art.astro";
import BookingPanel from "../components/BookingPanel.astro";
import BookingScript from "../components/BookingScript.astro";
import Helper from "../components/Helper.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import coast from "../assets/art/coast.webp";
import field from "../assets/art/field.webp";
import { helpers } from "../data/helpers";
import { care, eur, founding, pilot, pilotOpen, review, setup } from "../data/offer";
import { offers, orgId, siteUrl, toJsonLd, websiteId } from "../data/schema";
import { eisGrantsPage, email, estoniaPage, introCallUrl } from "../data/site";
import {
  answers,
  businessTypes,
  comparison,
  eisAiGrantUrl,
  eisGrantUrl,
  faqs,
  fitSigns,
  glance,
  grantChecked,
  grantFacts,
  jobs,
  lastUpdated,
  safety,
  steps,
} from "../data/estonia";

const title = "AI for Small Business in Estonia | Seestemic";
const description = `Tallinn-based AI setup for small businesses: quotes, inbox, bookings, invoices, inside your own tools. You approve first. Free ${review.minutes}-min AI review.`;
const lead =
  "We set up AI helpers that take repetitive jobs off your plate, inside the tools you already use. Nothing important happens without your OK.";

const booking = {
  href: introCallUrl,
  target: "_blank",
  rel: "noreferrer",
  "data-booking-trigger": "",
  "aria-expanded": "false",
  "aria-controls": "intro-call-calendar",
};

const links = [
  { label: "Examples", href: "#what" },
  { label: "Prices", href: "#cost" },
  { label: "Funding", href: "#funding" },
  { label: "Questions", href: "#faq" },
] as const;

const contents = [
  ...Object.entries(answers).map(([id, { nav }]) => ({ id, nav })),
  { id: "faq", nav: "Questions" },
];

// Structured data. The organisation and website are defined once, in src/data/schema.ts; this page points at them by @id.
const pageUrl = new URL(estoniaPage.href, siteUrl).href;
const serviceId = `${pageUrl}#service`;

// Every question here is on the page with exactly this answer text: the section answers, then the FAQ.
const questions = [...Object.values(answers), ...faqs];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: "en",
      dateModified: lastUpdated.iso,
      isPartOf: { "@id": websiteId },
      about: { "@id": orgId },
      mainEntity: { "@id": serviceId },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    },
    // What the page sells, to whom and for how much: the hero lead, "Who is Seestemic for?" and the price table.
    {
      "@type": "Service",
      "@id": serviceId,
      name: "AI helpers for small businesses in Estonia",
      description: lead,
      provider: { "@id": orgId },
      areaServed: { "@type": "Country", name: "Estonia" },
      audience: {
        "@type": "BusinessAudience",
        audienceType: "Small businesses with 1 to 20 people, such as trades, clinics and shops",
        numberOfEmployees: { "@type": "QuantitativeValue", minValue: 1, maxValue: 20 },
      },
      offers,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: estoniaPage.label, item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#questions`,
      mainEntity: questions.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={toJsonLd(schema)} />

  <SiteHeader home="/" links={links} />

  <main id="main">
    <section class="guide-hero" id="top" aria-labelledby="page-title">
      <div class="shell guide-hero-grid">
        <div class="guide-hero-copy">
          <h1 class="guide-title" id="page-title">AI for small businesses in Estonia, <span class="nowrap">set up for you</span></h1>
          <p class="lead guide-hero-lead">{lead}</p>
          <div class="cta-row guide-hero-ctas">
            <a class="btn btn-primary" {...booking}>Book a free {review.minutes}-minute AI review</a>
            <a class="btn btn-secondary" href="#what">See what a helper does</a>
          </div>
          <p class="hero-note">
            <Icon name="check" size={16} />
            Run from Tallinn. No tech skills needed.
          </p>
        </div>

        <div class="guide-hero-art">
          <Art src={coast} sizes="(min-width: 900px) 540px, 100vw" eager />
          <section class="glance" aria-labelledby="glance-title">
            <h2 class="glance-title" id="glance-title">Seestemic at a glance</h2>
            <dl class="guide-dl">
              {
                glance.map(({ label, value }) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="glance-updated">Updated <time datetime={lastUpdated.iso}>{lastUpdated.label}</time></p>
          </section>
        </div>
      </div>
    </section>

    <div class="shell guide-body">
      <aside class="guide-aside">
        <nav class="guide-toc" aria-labelledby="toc-title">
          <p class="guide-toc-title" id="toc-title">On this page</p>
          <ol>
            {
              contents.map(({ id, nav }) => (
                <li>
                  <a href={`#${id}`}>{nav}</a>
                </li>
              ))
            }
          </ol>
        </nav>
        <a class="btn btn-primary btn-sm guide-toc-cta" {...booking} data-booking-from="contents">
          Book a free AI review
        </a>
      </aside>

      <div class="guide-main">
        <section class="guide-section" id="who" aria-labelledby="who-title">
          <h2 class="guide-h2" id="who-title">{answers.who.question}</h2>
          <p class="guide-answer">{answers.who.answer}</p>
          <dl class="guide-dl guide-facts">
            {
              businessTypes.map(({ type, text }) => (
                <div>
                  <dt>{type}</dt>
                  <dd>{text}</dd>
                </div>
              ))
            }
          </dl>
          <p class="guide-text">Another kind of business? What matters is the job, not the industry.</p>
        </section>

        <section class="guide-section" id="worth" aria-labelledby="worth-title">
          <h2 class="guide-h2" id="worth-title">{answers.worth.question}</h2>
          <p class="guide-answer">{answers.worth.answer}</p>
          <p class="guide-text">It’s usually a good fit if:</p>
          <ul class="guide-checks">
            {
              fitSigns.map((sign) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>{sign}</span>
                </li>
              ))
            }
          </ul>
          <p class="guide-text">
            Not sure? Bring the job to the free AI review, and we’ll tell you honestly whether AI is a good fit.
          </p>
        </section>

        <section class="guide-section" id="what" aria-labelledby="what-title">
          <h2 class="guide-h2" id="what-title">{answers.what.question}</h2>
          <p class="guide-answer">{answers.what.answer}</p>
          <p class="guide-jobs-note">
            <span class="example-tag">Example</span>
            The messages below are examples, not client results.
          </p>
          <ul class="guide-jobs">
            {
              jobs.map(({ helper, job, example }) => (
                <li class="guide-job">
                  <Helper variant="avatar" color={helpers[helper].color} class="guide-job-avatar" />
                  <div>
                    <h3>{helpers[helper].name}</h3>
                    <p>{job}</p>
                    <p class="guide-job-msg tnum">{example}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="guide-more">
            <a href="/#examples">
              See the helpers at work
              <Icon name="arrowRight" size={16} />
            </a>
          </p>
        </section>

        <section class="guide-section" id="safe" aria-labelledby="safe-title">
          <h2 class="guide-h2" id="safe-title">{answers.safe.question}</h2>
          <p class="guide-answer">{answers.safe.answer}</p>
          <figure class="guide-figure">
            <div class="guide-figure-art" aria-hidden="true">
              <Art src={field} sizes="(min-width: 1100px) 880px, 100vw" />
              <span class="example-tag">Example</span>
              <div class="v-panel v-approve">
                <header class="v-approve-head">
                  <Helper variant="avatar" color={helpers.quotes.color} class="v-avatar" />
                  <span><b>Quotes</b> wants to send a quote</span>
                  <span class="tnum">9:41</span>
                </header>
                <div class="v-approve-body">
                  <span>Q-1042 · Dental clinic</span>
                  <b class="tnum">€4,860</b>
                </div>
                <div class="v-approve-actions">
                  <span class="pill pill-dark">Approve</span>
                  <span class="pill pill-light">Edit</span>
                  <span class="pill pill-ghost">Not now</span>
                </div>
                <p class="v-approve-rule">
                  <Icon name="lock" size={14} />
                  Quotes over €1,000 always need your OK
                </p>
              </div>
            </div>
            <figcaption>The Quotes helper waits for your OK before it sends a quote over €1,000.</figcaption>
          </figure>
          <ul class="guide-points">
            {
              safety.map(({ title, text }) => (
                <li>
                  <b>{title}</b> {text}
                </li>
              ))
            }
          </ul>
          {/* TODO: link to the GDPR checklist page (board #4) once it is live. */}
        </section>

        <section class="guide-section" id="cost" aria-labelledby="cost-title">
          <h2 class="guide-h2" id="cost-title">{answers.cost.question}</h2>
          <p class="guide-answer">{answers.cost.answer}</p>
          <div class="guide-table-wrap">
            <table class="guide-table guide-prices" role="table">
              <caption class="sr-only">Seestemic prices</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">What</th>
                  <th scope="col" role="columnheader">Price</th>
                  <th scope="col" role="columnheader">What you get</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                <tr role="row">
                  <th scope="row" role="rowheader">Free AI review</th>
                  <td role="cell" class="guide-price tnum"><b>{eur(review.price)}</b></td>
                  <td role="cell">A {review.minutes}-minute call about the jobs that take up your week, and an honest view of where AI can help.</td>
                </tr>
                {
                  pilotOpen ? (
                    <tr role="row">
                      <th scope="row" role="rowheader">
                        First helper
                        <span class="pill pill-light guide-pill">First {founding.places} clients</span>
                      </th>
                      <td role="cell" class="guide-price tnum">
                        <b>{eur(pilot.price)}</b> one-time
                        <s>
                          <span class="sr-only">normally from </span>{eur(setup.from)}
                        </s>
                      </td>
                      <td role="cell">One small helper, set up for one task. In return, you write a short case study after {pilot.caseStudyAfter}.</td>
                    </tr>
                  ) : (
                    <tr role="row">
                      <th scope="row" role="rowheader">First helper</th>
                      <td role="cell" class="guide-price tnum">
                        from <b>{eur(setup.from)}</b> one-time
                      </td>
                      <td role="cell">Your first helper, set up for one job inside your tools, with your approval rules built in.</td>
                    </tr>
                  )
                }
                <tr role="row">
                  <th scope="row" role="rowheader">Care <small>optional</small></th>
                  <td role="cell" class="guide-price tnum">from <b>{eur(care.from)}</b> a month</td>
                  <td role="cell">
                    Up to {care.hours} hours of our team’s time each month, plus a monthly check-in. It starts after {care.startsAfter}.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <ul class="guide-notes">
            <li>AI costs, such as an AI subscription, are paid separately.</li>
            <li>No VAT is added, as Seestemic isn’t <span class="nowrap">VAT-registered</span>.</li>
            <li>You keep everything we build, even if you stop Care.</li>
            <li>
              Setups of <span class="tnum">€4,000</span> or more may qualify for <a href="#funding">EIS co-funding</a>.
            </li>
          </ul>
          {/* TODO: link to the AI cost guide (board #3) and the founding pilot page (board #14) once they are live. */}
          <div class="guide-cta">
            <a class="btn btn-primary" {...booking}>Book a free AI review</a>
          </div>
        </section>

        <section class="guide-section" id="funding" aria-labelledby="funding-title">
          <h2 class="guide-h2" id="funding-title">{answers.funding.question}</h2>
          <p class="guide-answer">{answers.funding.answer}</p>
          <dl class="guide-dl guide-facts">
            {
              grantFacts.map(({ label, value }) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="guide-text">
            Other conditions apply, so read them on eis.ee before you plan around the grant. EIS’s separate{" "}
            <a href={eisAiGrantUrl} target="_blank" rel="noreferrer">grant for adopting artificial intelligence</a> closed
            on 24 August 2026, once applications exceeded its remaining budget.
          </p>
          <p class="guide-source">
            <a href={eisGrantUrl} target="_blank" rel="noreferrer">
              See the software grant on eis.ee
              <Icon name="external" size={15} />
            </a>
            <span>Checked on <time datetime={grantChecked.iso}>{grantChecked.label}</time></span>
          </p>
          <p class="guide-more">
            <a href={eisGrantsPage.href}>
              Read our guide to EIS grants for AI and software
              <Icon name="arrowRight" size={16} />
            </a>
          </p>
        </section>

        <section class="guide-section" id="how" aria-labelledby="how-title">
          <h2 class="guide-h2" id="how-title">{answers.how.question}</h2>
          <p class="guide-answer">{answers.how.answer}</p>
          <ol class="guide-steps">
            {
              steps.map(({ title, text }, index) => (
                <li>
                  <span class="guide-step-num tnum" aria-hidden="true">
                    {index + 1}
                  </span>
                  <div>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="guide-section" id="why" aria-labelledby="why-title">
          <h2 class="guide-h2" id="why-title">{answers.why.question}</h2>
          <p class="guide-answer">{answers.why.answer}</p>
          <div class="guide-table-wrap">
            <table class="guide-table guide-compare" role="table">
              <caption class="sr-only">Setting up AI yourself compared with a done-for-you setup</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <td role="cell"></td>
                  <th scope="col" role="columnheader">Doing it yourself</th>
                  <th scope="col" role="columnheader">With Seestemic</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {
                  comparison.map(({ topic, diy, us }) => (
                    <tr role="row">
                      <th scope="row" role="rowheader">{topic}</th>
                      <td role="cell" data-label="Doing it yourself">{diy}</td>
                      <td role="cell" data-label="With Seestemic">{us}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section class="guide-section" id="faq" aria-labelledby="faq-title">
          <h2 class="guide-h2" id="faq-title">Frequently asked questions</h2>
          <div class="guide-qa">
            {
              faqs.map(({ question, answer }) => (
                <div class="guide-qa-item">
                  <h3>{question}</h3>
                  <p>{answer}</p>
                </div>
              ))
            }
          </div>
          <p class="guide-updated">Last updated <time datetime={lastUpdated.iso}>{lastUpdated.label}</time></p>
        </section>
      </div>
    </div>

    <section class="guide-close" id="book" aria-labelledby="book-title">
      <div class="shell">
        <div class="guide-close-inner">
          <h2 class="h2 guide-close-title" id="book-title">Bring one repetitive job to a free AI review</h2>
          <p class="closing-sub">
            It’s a {review.minutes}-minute call. We’ll tell you honestly whether AI can help, and where to start.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" {...booking}>Book a free {review.minutes}-minute AI review</a>
            <a class="btn btn-secondary" href={`mailto:${email}`}>Email us</a>
          </div>
          <p class="closing-note">
            <Icon name="lock" size={16} />
            Your data can stay in the EU, and we sign a data processing agreement with you. Prefer email? Write to <a
              href={`mailto:${email}`}>{email}</a
            >.
          </p>
          <BookingPanel />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter base="/" />

  <script>
    // Marks the section being read in the "On this page" list.
    const tocLinks = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>(".guide-toc a")].map((link) => [link.hash.slice(1), link]),
    );
    let currentLink: HTMLAnchorElement | undefined;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = tocLinks.get(entry.target.id);
          if (!entry.isIntersecting || !link || link === currentLink) continue;
          currentLink?.removeAttribute("aria-current");
          link.setAttribute("aria-current", "location");
          currentLink = link;
        }
      },
      { rootMargin: "-25% 0px -65% 0px" },
    );
    tocLinks.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  </script>

  <BookingScript />
</BaseLayout>
