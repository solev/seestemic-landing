---
import "../styles/global.css";
import geist from "../assets/fonts/geist.woff2?url";
import { analytics } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Share image for og:image and twitter:image, 1200x630, as a path under public/ or an absolute URL. */
  image?: { src: string; alt: string };
  /** For pages that must stay out of search, such as the 404 page. Also drops the canonical link. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = { src: "/og.png", alt: "Seestemic: AI helpers for the busywork in your business" },
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Seestemic" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <slot name="head" />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline define:vars={{ analytics }}>
            window.op =
              window.op ||
              (() => {
                const queue = [];
                return new Proxy(
                  function () {
                    if (arguments.length) queue.push([].slice.call(arguments));
                  },
                  {
                    get: (_, key) => (key === "q" ? queue : (...args) => queue.push([key, ...args])),
                    has: (_, key) => key === "q",
                  },
                );
              })();
            window.op("init", {
              apiUrl: analytics.apiUrl,
              clientId: analytics.clientId,
              trackScreenViews: true,
              trackOutgoingLinks: true,
              trackAttributes: true,
            });
          </script>
          <script is:inline src={analytics.scriptUrl} defer async />
        </>
      )
    }
  </head>
  <body>
    <!--
      THESIS: A business owner grasps in five seconds that Seestemic sets up AI helpers that take repetitive jobs off their plate, and that they stay in charge.
      OWN-WORLD: Grok Bot's product page, pinned by the brief, rebuilt with Seestemic's own assets: white ground, near-black Geist, warm gray cards, black pills, product UI floating on painted landscapes, an original speech-bubble helper whose eyes follow you.
      STORY: meet the helper, watch one finish a job, talk to it, see how it fits, pick a job, three steps with prices, meet Martin, questions, book a free AI review.
      FIRST VIEWPORT: centred "Let [helper] AI handle the busywork" on white ground, with the painted stage below holding the example app already working.
      FORM: brief-pinned style over the seed roll (seed key c1d99fa6).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
