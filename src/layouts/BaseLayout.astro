---
import "../styles/global.css";
import geist from "../assets/fonts/geist.woff2?url";
import { analytics } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Share image for og:image and twitter:image, 1200x630, as a path under public/ or an absolute URL. Defaults to the site share video's first frame. */
  image?: { src: string; alt: string };
  /** Muted looping MP4 for og:video, as a path under public/ or an absolute URL. Chat apps such as Discord and Telegram play it inline, with `image` as its poster, so `image` should be its first frame. Defaults to the site share video, except on articles and on pages that set their own `image`. */
  video?: { src: string; width: number; height: number };
  /** For pages that must stay out of search, such as the 404 page. Also drops the canonical link. */
  noindex?: boolean;
  /** Open Graph type. Guides are articles, with their published and modified dates. */
  article?: { published: string; modified: string };
}

const siteShare = {
  image: {
    src: "/og/home.jpg",
    alt: "Seestemic: Let AI teammates handle the busywork, above an example window where the quote writer gets a new request from a dental clinic",
  },
  video: { src: "/og/home.mp4", width: 1280, height: 720 },
};
const { title, description, noindex = false, article } = Astro.props;
const image = Astro.props.image ?? siteShare.image;
// The site video plays only over its own first frame, and articles keep og:type article, which Discord shows without video.
const video = Astro.props.video ?? (Astro.props.image || article ? undefined : siteShare.video);
// Canonical URLs have no trailing slash, so /ai-for-small-business-estonia/ and the bare path count as one page.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
const videoUrl = video && new URL(video.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {/* Discord takes its layout from whichever of twitter:card and og:type comes last, and plays og:video only for a video og:type. So og:type comes second: a page with a video plays it inline there, and X keeps the large image. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content={article ? "article" : video ? "video.other" : "website"} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published} />
          <meta property="article:modified_time" content={article.modified} />
        </>
      )
    }
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Seestemic" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    {
      video && (
        <>
          <meta property="og:video" content={videoUrl} />
          <meta property="og:video:secure_url" content={videoUrl} />
          <meta property="og:video:type" content="video/mp4" />
          <meta property="og:video:width" content={video.width} />
          <meta property="og:video:height" content={video.height} />
        </>
      )
    }
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <slot name="head" />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline define:vars={{ analytics }}>
            window.op =
              window.op ||
              (() => {
                const queue = [];
                return new Proxy(
                  function () {
                    if (arguments.length) queue.push([].slice.call(arguments));
                  },
                  {
                    get: (_, key) => (key === "q" ? queue : (...args) => queue.push([key, ...args])),
                    has: (_, key) => key === "q",
                  },
                );
              })();
            window.op("init", {
              apiUrl: analytics.apiUrl,
              clientId: analytics.clientId,
              trackScreenViews: true,
              trackOutgoingLinks: true,
              trackAttributes: true,
            });
          </script>
          <script is:inline src={analytics.scriptUrl} defer async />
        </>
      )
    }
  </head>
  <body>
    <!--
      THESIS: A business owner grasps in five seconds that Seestemic sets up AI teammates that take repetitive jobs off their plate, and that they stay in charge.
      OWN-WORLD: Grok Bot's product page, pinned by the brief, rebuilt with Seestemic's own assets: white ground, near-black Geist, warm gray cards, black pills, product UI floating on painted landscapes, an original speech-bubble helper whose eyes follow you.
      STORY: meet the AI teammates, watch one finish a job, see what we do and what you do, pick a job, talk to it, see how it fits, three steps with prices, meet Martin and the team, questions, book a free AI review.
      FIRST VIEWPORT: centred "Let [helper] AI teammates handle the busywork" on white ground, with the painted stage below holding the example app already working.
      FORM: brief-pinned style over the seed roll (seed key c1d99fa6).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
